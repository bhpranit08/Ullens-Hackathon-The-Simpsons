PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/trailguard
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:8081
RUN_WORKER=true
# preview is a local mailbox: email is NOT sent. Use resend for actual delivery.
MAIL_MODE=preview
RESEND_API_KEY=
MAIL_FROM=
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
